{
  "rewrites": [
    {
      "source": "/products/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/order-success/:path*",
      "destination": "/index.html"
    }
  ]
}
